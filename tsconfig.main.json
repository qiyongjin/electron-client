{
    "compilerOptions": {
        "composite": true,
        "target": "ES2020",
        "module": "NodeNext",
        "lib": [
            "ES2020"
        ],
        "outDir": "dist/main",
        "rootDir": "src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "moduleResolution": "nodenext",  // ✅ 正确，不需要 ignoreDeprecations
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        /* Path Mapping */
        "paths": {
            "@/*": ["./src/main/*"],
            "@shared/*": ["./src/shared/*"],
            "@renderer/*": ["./src/renderer/*"],
            "@preload/*": ["./src/preload/*"]
        }
    },
    "include": [
        "src/main/**/*"  // 修复：移除多余的逗号
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}