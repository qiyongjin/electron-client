{
    "compilerOptions": {
        "composite": true,
        "target": "ES2020",
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "outDir": "dist/main",
        "rootDir": "./src",  // 修改为 ../src
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "emitDeclarationOnly": true,
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "ignoreDeprecations": "5.0",
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/renderer/*"
            ],
            "@shared/*": [
                "src/shared/*"
            ],
            "@main/*": [
                "src/main/*"
            ]
        }
    },
    "include": [
        "src/renderer/**/*",
        "src/shared/**/*",
        "src/preload/types.ts"
    ],
    "exclude": [
        "src/main",
        "src/preload",
        "node_modules",
        "dist"
    ]
}
