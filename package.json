{
  "name": "mini_seven",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development npm run build:all && concurrently \"npm run serve:renderer\" \"npm run start-electron\"",
    "build:all": "npm run build:renderer && npm run build:electron:dev",
    "serve:renderer": "vite dev",
    "dev:renderer": "vite",
    "start-electron": "electron dist/main/main/main.js",
    "build:electron:dev": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "npm run build:main && npm run build:preload",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "dist": "cross-env NODE_ENV=production npm run build:all && electron-builder --publish=never",
    "dist:all": "npm run build:all && electron-builder -mwl --publish=never",
    "dist:win": "npm run build:all && electron-builder --win --publish=never --config electron-builder.yml",
    "dist:wl": "npm run build:all && electron-builder -wl --publish=never",
    "dist:linux": "npm run build:all && electron-builder --linux --publish=never",
    "dist:mac": "npm run build:all && electron-builder --mac --publish=never"
  },
  "devDependencies": {
    "@electron-forge/plugin-vite": "^7.11.2",
    "@eslint/js": "^9.35.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "baseline-browser-mapping": "^2.11.5",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.43.0",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "4.1.16",
    "@tanstack/react-query": "5.90.6",
    "electron-is-dev": "^3.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "7.66.0",
    "react-router-dom": "^7.9.5",
    "tailwindcss": "4.1.16",
    "zod": "4.1.12",
    "zustand": "5.0.8"
  }
}
